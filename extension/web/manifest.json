{
  "manifest_version": 3,
  "name": "Safari AI Agent",
  "version": "0.2.1",
  "description": "Authenticated remote MCP browser bridge. Lets a connected AI inspect and act on one explicitly connected tab, with per-action approval.",
  "icons": {
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Safari AI Agent",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
