{
  "manifest_version": 3,
  "name": "ChatGPT Safari AI Agent",
  "version": "0.1.0",
  "description": "Autonomous browser automation assistant running on your personal ChatGPT plan.",
  "action": {
    "default_title": "ChatGPT Safari Agent",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}
